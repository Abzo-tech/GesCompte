    "components": {
        "schemas": {
            "Client": {
                "title": "Client",
                "description": "Représente un client bancaire",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nom": {
                        "type": "string",
                        "example": "Martin"
                    },
                    "prenom": {
                        "type": "string",
                        "example": "Jean"
                    },
                    "email": {
                        "type": "string",
                        "example": "jean.martin@example.com"
                    },
                    "telephone": {
                        "type": "string",
                        "example": "01 23 45 67 89"
                    },
                    "adresse": {
                        "type": "string",
                        "example": "123 Avenue de la Test"
                    },
                    "statut": {
                        "type": "string",
                        "example": "actif"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Compte": {
                "title": "Compte",
                "description": "Représente un compte bancaire",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "numero": {
                        "type": "string",
                        "example": "CMPT2025A1B2C3D4"
                    },
                    "type": {
                        "type": "string",
                        "example": "epargne"
                    },
                    "statut": {
                        "type": "string",
                        "example": "actif"
                    },
                    "client_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Transaction": {
                "title": "Transaction",
                "description": "Représente une transaction bancaire",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "reference": {
                        "type": "string",
                        "example": "TRX20251026001"
                    },
                    "compte_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "type": {
                        "type": "string",
                        "example": "depot"
                    },
                    "montant": {
                        "type": "number",
                        "format": "float",
                        "example": 1000.5
                    },
                    "description": {
                        "type": "string",
                        "example": "Dépôt salaire"
                    },
                    "beneficiaire": {
                        "type": "string",
                        "example": "Jean Martin"
                    },
                    "date_transaction": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
